APP_ENV=development
# Use the pooled Neon connection string for hosted PostgreSQL.
# Keep the SQLite value only when running fully local development.
DATABASE_URL=sqlite:///./kasauti.db
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# goldapi = real spot price (USD/oz -> INR/g). mock = fake dev data.
RATE_PROVIDER=goldapi
# Calibrate spot to Indian retail (import duty + local premium). Compare with a local jeweller's quote and tune.
RATE_ADJUST_GOLD_PCT=0
RATE_ADJUST_SILVER_PCT=0

# AI provider: groq (default if GROQ_API_KEY is set) or anthropic. Set LLM_PROVIDER to force one.
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
REMINDER_DAYS_BEFORE=3
